# OwlMonitor 代码风格配置 code style config
# 4 空格缩进、120 列、函数/类花括号另起一行、控制语句同行、指针左对齐、include 顺序保持手写
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
PointerAlignment: Left
DerivePointerAlignment: false
SortIncludes: false
AlignTrailingComments: true
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: false
  IndentBraces: false
AllowShortFunctionsOnASingleLine: Empty
